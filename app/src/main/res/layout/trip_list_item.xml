<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Expense Title (Clickable Link to Edit Expense Page) -->
    <TextView
        android:id="@+id/textView_expense_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Expense Title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_blue_dark"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_delete_expense"
        android:layout_marginEnd="8dp" />
    <!-- Expense Date -->
    <TextView
        android:id="@+id/textView_expense_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Expense Date"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_expense_title"
        app:layout_constraintEnd_toStartOf="@+id/button_delete_expense"
        android:layout_marginEnd="8dp" />

    <!-- Expense Amount -->
    <TextView
        android:id="@+id/textView_expense_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RM 0.00"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView_expense_date" />

    <!-- Delete Button -->
    <Button
        android:id="@+id/button_delete_expense"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
